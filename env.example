# =============================================================================
# Real-Time FX Shopping - Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in your actual API keys and secrets
# Never commit .env.local to version control!

# =============================================================================
# Stellar Network Configuration
# =============================================================================
# Stellar Horizon API endpoint (testnet by default)
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar network passphrase (testnet by default)
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Base fee for Stellar transactions (in stroops, 1 XLM = 10,000,000 stroops)
STELLAR_BASE_FEE=100

# =============================================================================
# MoneyGram Anchor Provider Configuration
# =============================================================================
# MoneyGram API credentials for real-time quotes and fees
# Get these from: https://developer.moneygram.com/
MONEYGRAM_API_KEY=your_moneygram_api_key_here
MONEYGRAM_API_URL=https://api.moneygram.com/v1
MONEYGRAM_CLIENT_ID=your_moneygram_client_id_here
MONEYGRAM_CLIENT_SECRET=your_moneygram_client_secret_here

# =============================================================================
# Freight Wallet Integration Configuration
# =============================================================================
# Freight Wallet API credentials for wallet connection and transaction signing
# Get these from: https://developer.freightwallet.com/
FREIGHT_WALLET_API_KEY=your_freight_wallet_api_key_here
FREIGHT_WALLET_API_URL=https://api.freightwallet.com/v1
FREIGHT_WALLET_CLIENT_ID=your_freight_wallet_client_id_here
FREIGHT_WALLET_REDIRECT_URI=http://localhost:3000/auth/callback

# =============================================================================
# WalletConnect Configuration
# =============================================================================
# WalletConnect Project ID for multi-wallet support
# Get this from: https://cloud.walletconnect.com/
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# =============================================================================
# Application Configuration
# =============================================================================
# Next.js environment
NODE_ENV=development

# Application URL (for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Security Configuration
# =============================================================================
# JWT secret for session management (generate a random string)
JWT_SECRET=your_jwt_secret_here

# Encryption key for sensitive data (generate a random 32-byte key)
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# =============================================================================
# Logging and Monitoring
# =============================================================================
# Enable debug logging
DEBUG=false

# Sentry DSN for error tracking (optional)
SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# Rate Limiting
# =============================================================================
# API rate limiting (requests per minute)
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# =============================================================================
# Database Configuration (if using external database)
# =============================================================================
# Database URL (optional - for storing transaction history)
# DATABASE_URL=postgresql://username:password@localhost:5432/fxshopping

# =============================================================================
# External Service Configuration
# =============================================================================
# Redis URL for caching (optional)
# REDIS_URL=redis://localhost:6379

# =============================================================================
# Development vs Production
# =============================================================================
# Set to 'production' when deploying
NODE_ENV=development

# Enable/disable features based on environment
ENABLE_ANALYTICS=false
ENABLE_ERROR_REPORTING=false
